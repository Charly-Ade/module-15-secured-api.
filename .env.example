# Copy to .env and fill in. NEVER commit .env (it is gitignored).
NODE_ENV=development
PORT=3000

# Two DIFFERENT secrets, each >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Explicit frontend origin(s), comma-separated. No wildcard, no trailing slash/path.
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the app (0 = none, e.g. local dev).
TRUST_PROXY=0

# Requests per 15 min per IP.
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Optional: create one admin at startup (password: 8+ chars).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
